APPLICANT_CC=
CLIENT_INBOX=
GEMINI_API_KEY=
# REQUIRED for all OTP / signed drafts (forms + recruitment). Generate with:
#   openssl rand -hex 32
# Must be at least 32 characters. Never commit the real value.
# Without this, OTP endpoints return 503 OTP_SECRET_MISSING.
OTP_SECRET=
# Amazon SES SMTP credentials (Sydney region): set as Cloudflare Pages secrets; never commit real values
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_EMAIL_FROM=OPERAVA <noreply@operavaglobal.com>
TALENT_INBOX=

# MEGA backup (Pages Function /api/mega-backup — preferred)
MEGA_EMAIL=
MEGA_PASSWORD=
# Preferred auth secret for POST /api/mega-backup (Bearer token)
MEGA_BACKUP_SHARED_SECRET=
# Legacy aliases (still accepted if MEGA_BACKUP_SHARED_SECRET is empty):
# BACKUP_SHARED_SECRET=
# MEGA_BACKUP_SECRET=

# Optional external Worker webhook (only if not using direct Pages MEGA_*):
MEGA_BACKUP_URL=

# Ava Screening (separate from legacy Recruitment AVA; disabled unless enabled explicitly)
AVA_SCREENING_ENABLED=false
# Both secrets must be independent random strings of 32+ characters; configure as Cloudflare secrets.
AVA_SCREENING_SECRET=
AVA_REVIEWER_SECRET=
# Separate elevated authorization for irreversible deletion of candidate records.
AVA_DELETION_SECRET=
# Cloudflare Access recruitment-admin application audience and team domain, nonsecret.
AVA_ACCESS_AUD=
AVA_ACCESS_TEAM_DOMAIN=
# Additional Cloudflare Pages binding (not a text secret): private R2 bucket AVA_ID_BUCKET.
# Optional Workers AI binding: AI (advisory writing feedback; never an automated hiring decision).
