/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache static assets with immutable cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache favicon and manifest
/favicon*
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=86400

# AVA applicant camera and microphone capture are explicitly user initiated.
# Keep camera/microphone disabled on every other website route.
# Both the legacy screening URL and the applicant portal share the same React SPA.
/ava-screening/*
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/ava-screening
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/applicant-portal/*
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/applicant-portal
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

# Private Access-protected admin SPA and server endpoints. Not discoverable via public site.
/recruitment-admin/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Content-Type-Options: nosniff
