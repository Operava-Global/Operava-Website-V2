{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operava-website-v2",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "dist",
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    { "binding": "AVA_PROCTOR_BUCKET", "bucket_name": "operava-ava-proctor-evidence" },
    { "binding": "AVA_ID_BUCKET", "bucket_name": "operava-ava-identity-evidence" }
  ],
  "d1_databases": [
    {
      "binding": "SUBMISSIONS_DB",
      "database_name": "operava-submissions",
      "database_id": "19f8a477-6369-49de-bb25-2c9358820757"
    }
  ],
  "vars": {
    "NODE_VERSION": "22",
    "SES_EMAIL_FROM": "OPERAVA <noreply@operavaglobal.com>",
    "CLIENT_INBOX": "hello@operavaglobal.com",
    "TALENT_INBOX": "talents@operavaglobal.com",
    "SES_SMTP_HOST": "email-smtp.ap-southeast-2.amazonaws.com",
    "ACADEMY_INBOX": "academy@operavaglobal.com",
    "AVA_SCREENING_ENABLED": "true",
    "AVA_TURNSTILE_SITE_KEY": "0x4AAAAAAFm-aW4IrjCV-iTl",
    "AVA_ACCESS_AUD": "309b4030d6c8fd4a15a20b2ef0fcb032301225d4c5d9d8e49c08030ca9059abd",
    "AVA_ACCESS_TEAM_DOMAIN": "dry-rain-3eba.cloudflareaccess.com"
  }
}
